rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isParticipant(gameData) {
      return isSignedIn() &&
        (request.auth.uid == gameData.whitePlayerId ||
         request.auth.uid == gameData.blackPlayerId);
    }

    // ---------------------------
    // USERS (private document)
    // ---------------------------
    // Email, uid and rating bookkeeping are owner-only. Everything the
    // public needs is mirrored into /publicProfiles by Cloud Functions.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) &&
        // users may edit their own profile, but never their ratings,
        // verification flags or aggregated stats
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['rating', 'ratingBullet', 'ratingBlitz', 'ratingRapid',
                   'ratingBulletGames', 'ratingBlitzGames',
                   'ratingRapidGames', 'isVerified', 'isAdmin', 'stats',
                   'lastGameAt']);
      allow delete: if false; // account deletion goes through a Cloud Function

      match /puzzleProgress/{progressId} {
        allow read, write: if isOwner(userId);
      }

      match /ratingHistory/{entryId} {
        allow read: if isOwner(userId);
        allow write: if false; // written by Cloud Functions only
      }
    }

    // ---------------------------
    // PUBLIC PROFILES (mirrored from /users by Cloud Functions)
    // ---------------------------
    match /publicProfiles/{userId} {
      allow read: if true;
      allow write: if false;
    }

    // ---------------------------
    // GAMES (metadata; live moves live in Realtime Database)
    // ---------------------------
    match /games/{gameId} {
      allow read: if true; // games are publicly viewable (spectator mode)

      // You can only create a game you are playing in, and only bot games
      // may carry a result straight away (online results are reported
      // through the submitGameResult Cloud Function).
      allow create: if isSignedIn() &&
        (request.resource.data.whitePlayerId == request.auth.uid ||
         request.resource.data.blackPlayerId == request.auth.uid) &&
        request.resource.data.moves is list &&
        (!request.resource.data.keys().hasAny(['result']) ||
         request.resource.data.isBotGame == true);

      // Offline/bot games can only be saved (never rewritten), and the
      // result is server-owned for rated games.
      allow update: if isParticipant(resource.data) &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['result', 'reason', 'moves', 'finalFen', 'rated',
                   'ratedApplied', 'whitePlayerId', 'blackPlayerId']);

      allow delete: if false;
    }

    // ---------------------------
    // NOTIFICATIONS (written by Cloud Functions, read/marked by owner)
    // ---------------------------
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create, delete: if false;
    }

    // ---------------------------
    // FRIENDS
    // ---------------------------
    match /friendRequests/{requestId} {
      allow read: if isSignedIn() &&
        (request.auth.uid == resource.data.fromUserId ||
         request.auth.uid == resource.data.toUserId);
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.fromUserId;
      allow update: if isSignedIn() && request.auth.uid == resource.data.toUserId;
      allow delete: if isSignedIn() &&
        (request.auth.uid == resource.data.fromUserId ||
         request.auth.uid == resource.data.toUserId);
    }

    match /friendships/{friendshipId} {
      allow read: if isSignedIn() &&
        request.auth.uid in resource.data.memberIds;
      allow create: if isSignedIn() &&
        request.resource.data.memberIds is list &&
        request.auth.uid in request.resource.data.memberIds;
      allow update: if isSignedIn() &&
        request.auth.uid in resource.data.memberIds;
      allow delete: if isSignedIn() &&
        request.auth.uid in resource.data.memberIds;
    }

    // ---------------------------
    // MESSAGES (private chat between two users)
    // ---------------------------
    match /conversations/{conversationId} {
      allow read, update: if isSignedIn() &&
        request.auth.uid in resource.data.memberIds;
      allow create: if isSignedIn() &&
        request.auth.uid in request.resource.data.memberIds &&
        request.resource.data.memberIds.size() == 2;

      match /messages/{messageId} {
        allow read: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds;
        allow create: if isSignedIn() &&
          request.auth.uid == request.resource.data.senderId &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds;
        allow update, delete: if false;
      }
    }

    // ---------------------------
    // CLUBS
    // ---------------------------
    match /clubs/{clubId} {
      allow read: if true;
      allow create: if isSignedIn() &&
        request.auth.uid in request.resource.data.adminIds;
      allow update: if isSignedIn() &&
        (request.auth.uid in resource.data.adminIds ||
         request.auth.uid in request.resource.data.memberIds);
      allow delete: if false;

      match /posts/{postId} {
        allow read: if true;
        allow create: if isSignedIn() &&
          request.auth.uid == request.resource.data.authorId;
        allow update, delete: if isSignedIn() &&
          request.auth.uid == resource.data.authorId;
      }
    }

    // ---------------------------
    // FORUMS
    // ---------------------------
    match /forumCategories/{categoryId} {
      allow read: if true;
      allow write: if false; // seeded/managed via Cloud Functions or admin console
    }

    match /forumTopics/{topicId} {
      allow read: if true;
      allow create: if isSignedIn() &&
        request.auth.uid == request.resource.data.authorId;
      allow update: if isSignedIn() && request.auth.uid == resource.data.authorId;
      allow delete: if false;

      match /replies/{replyId} {
        allow read: if true;
        allow create: if isSignedIn() &&
          request.auth.uid == request.resource.data.authorId;
        allow update, delete: if isSignedIn() &&
          request.auth.uid == resource.data.authorId;
      }
    }

    // ---------------------------
    // PUZZLES (read-only content, managed server-side)
    // ---------------------------
    // NOTE: `ratingPuzzle` and `puzzleStats` are deliberately NOT in the
    // protected list above — puzzle progress is single-player, so letting
    // the solver write their own puzzle rating keeps the feature working
    // without a Cloud Function round-trip. Rated *games* stay server-only.
    match /puzzles/{puzzleId} {
      allow read: if true;
      allow write: if false;
    }

    match /puzzleDaily/{dateKey} {
      allow read: if true;
      allow write: if false;
    }

    // ---------------------------
    // TOURNAMENTS
    // ---------------------------
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow create: if isSignedIn() &&
        request.auth.uid in request.resource.data.organizerIds;
      allow update: if isSignedIn() &&
        (request.auth.uid in resource.data.organizerIds ||
         request.auth.uid in request.resource.data.playerIds);
      allow delete: if false;
    }

    // ---------------------------
    // LEADERBOARD SNAPSHOTS (written by Cloud Functions / admins)
    // ---------------------------
    match /leaderboards/{boardId} {
      allow read: if true;
      allow write: if false;
    }

    // Default deny for anything not explicitly matched above
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

